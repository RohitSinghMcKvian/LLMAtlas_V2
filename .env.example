# ============================================================
# LLMAtlas — Environment Variables Template
# Copy to .env.local and fill in your keys.
# Every key is optional — the app routes around missing ones.
# ============================================================

# ─── Internal Auth ────────────────────────────────────────────────────────────
# A random secret for JWT signing (generate with: openssl rand -base64 32)
JWT_SECRET=

# ─── Auth.js / NextAuth v5 ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Database (Neon Serverless Postgres) ──────────────────────────────────────
# Create a free database at: https://console.neon.tech
# Then run: npx prisma db push
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications
# Callback URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Create a free account at: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=LLMAtlas <noreply@llmatlas.app>

# ─── LLM Providers ────────────────────────────────────────────────────────────

# Groq — fastest free inference (Llama 3.3, Mixtral, Gemma)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — gateway to 30+ free models
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face Inference API — free tier
# Get a key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Google AI Studio — Gemini free tier (1,500 req/day)
# Get a key: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Cerebras — ultra-fast Llama 3.3 free tier
# Get a key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Mistral La Plateforme — free tier
# Get a key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# Together AI — $1 free credits
# Get a key: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Cloudflare Workers AI — generous free tier
# Get account & token: https://dash.cloudflare.com/
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# NVIDIA NIM — free tier, 13 models including Llama 4, GPT-OSS, Nemotron Super
# Get a key: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=

# xAI — Grok 4 / Grok 3, free monthly credits for new accounts
# Get a key: https://console.x.ai
XAI_API_KEY=

# DeepSeek — direct API for V4 Pro, R1, Coder (free tier + low-cost)
# Get a key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Pollinations — KEYLESS for end users. Set this ONE operator-side token to unlock the
# full frontier catalogue (Claude Opus 4.8, GPT-5.5, DeepSeek Pro, Kimi K2.6, MiniMax M3,
# Qwen, Grok, Llama 4). Your users never enter a key — the server attaches this token.
# Without it, only the anonymous GPT-OSS models work (and are rate-limited per IP).
# Get a free token: https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# ─── External Data APIs ────────────────────────────────────────────────────────

# NewsAPI — live AI/LLM headlines for dashboard feed
# Get a key: https://newsapi.org/register
NEWSAPI_KEY=

# GitHub — trending AI repos, higher rate limits when authenticated
# Create a token: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ─── Public URL ───────────────────────────────────────────────────────────────
# No trailing slash. Used for OpenRouter referrer header.
NEXT_PUBLIC_APP_URL=http://localhost:3000
